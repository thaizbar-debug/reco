rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // /publications/{pubId}/{uid}/{filename}
    //
    // Photos uploaded for user-submitted property listings.
    //
    // - read: public. Approved listings are shown in the search to all
    //         visitors; pending ones are only linked from the owner's
    //         "Mis publicaciones" view but URLs are unguessable, so a
    //         public read is acceptable for an MVP.
    //
    // - write: authenticated + the {uid} segment in the path must match
    //         request.auth.uid. Encoding the owner in the path avoids a
    //         cross-service firestore.get() call, which was intermittently
    //         returning null and causing storage/unauthorized even when the
    //         publication doc existed. Security is equivalent: only the
    //         owner can write to their own uid sub-folder, and pubIds are
    //         unguessable (auto-generated Firestore IDs).
    //
    //         Content type is whitelisted to raster formats only —
    //         image/svg+xml can carry <script> tags that execute in a
    //         viewer's browser.
    //
    // - delete: owner only (same uid check).
    match /publications/{pubId}/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType in [
                        'image/jpeg',
                        'image/png',
                        'image/webp'
                      ];
      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }

    // Legacy path (old uploads without uid segment) — read-only.
    match /publications/{pubId}/{filename} {
      allow read: if true;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
